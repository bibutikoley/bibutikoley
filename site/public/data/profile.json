ommit/61c524321aa71c0fc2128e7fa56cd37690f5220a","branch":"master","count":1,"head":"61c524321aa71c0fc2128e7fa56cd37690f5220a"}],"now":{"text":"Pushed to bibutikoley.github.io","at":"2026-11-11T10:53:54Z","url":"https://github.com/bibutikoley/bibutikoley.github.io/commit/01268eec79a96d3c5253a84101f1dfb89acc2959"},"about":{"headline":"Building agentic AI and mobile apps","role":"Team Lead, Medscape AI & Professional Apps · WebMD · Navi Mumbai","tagline":"I lead the Medscape AI and professional apps team at WebMD, ship Android and iOS apps, build agentic AI and developer tooling, and rebuild my stack whenever something better lands.","summary":"Most of my time now goes to the edge of what AI makes possible: agent-driven software lifecycles, MCP servers, LLM-powered apps, and speech pipelines that run on the device instead of in someone else's cloud. Underneath is nine years of Android, from a first developer job in 2017 to leading a team at WebMD, and lately iOS.","focus":[{"title":"AI-native development","blurb":"Agent-driven SDLC experiments, MCP servers, LLM chat and agent apps. Claude, Gemini, Qwen and local models are part of the daily toolchain, not a demo."},{"title":"Mobile, end to end","blurb":"Android with Jetpack Compose, iOS with SwiftUI, shared logic with Kotlin Multiplatform, Flutter when it fits. Clean architecture that survives feature growth."},{"title":"Voice & on-device AI","blurb":"Streaming speech recognition, language models and neural text-to-speech stitched into private, low-latency pipelines: Whisper, Parakeet, Kokoro, LiveKit, WebRTC."},{"title":"Latest tech, hands-on","blurb":"Three.js simulators, real-time WebRTC agents, FastAPI services and self-hosted models. If it shipped this year, there is probably a repo here trying it."}],"experience":[{"role":"Team Lead, Medscape AI & Professional Apps","company":"WebMD","period":"Oct 2025 – present","location":"Navi Mumbai","detail":"Leading the team behind Medscape's AI features and professional apps: agentic AI for clinicians alongside the Android and iOS apps, built with Kotlin Flow and Jetpack Compose. Highflier Award, 2026."},{"role":"Senior Software Engineer","company":"WebMD","period":"Oct 2022 – Oct 2025","location":"Navi Mumbai","detail":"Android engineering with Kotlin Flow and Compose across WebMD's consumer apps. Highflier Award in 2023 and 2025."},{"role":"Senior Software Developer","company":"OSP","period":"Nov 2020 – Oct 2022","location":"Mumbai","detail":"Mobile product development with user-centered design in agile teams."},{"role":"Software Developer","company":"OSP","period":"May 2019 – Nov 2020","location":"Mumbai","detail":"Android development, user-centered design, agile delivery."},{"role":"Android Developer","company":"GS Tecknoserve Pvt. Ltd.","period":"Aug 2017 – May 2019","location":"","detail":"First Android role: building and shipping native apps end to end."}],"highlights":[{"date":"2026-06","title":"Highflier Award","org":"WebMD","detail":"Third time: awarded for April–June 2026, the first as Team Lead.","url":"https://www.linkedin.com/in/bibutikoley/","kind":"award"},{"date":"2025-10","title":"Promoted to Team Lead, Medscape AI & Professional Apps","org":"WebMD","detail":"Leading the Medscape AI and professional apps team with full ownership, three years after joining as a senior engineer.","url":"https://www.linkedin.com/in/bibutikoley/"},{"date":"2025-06","title":"Highflier Award","org":"WebMD","detail":"Second time: awarded for April–June 2025.","url":"https://www.linkedin.com/in/bibutikoley/","kind":"award"},{"date":"2023-06","title":"Highflier Award","org":"WebMD","detail":"First time: awarded for April–June 2023, within a year of joining.","url":"https://www.linkedin.com/in/bibutikoley/","kind":"award"},{"date":"2022-10","title":"Joined WebMD as Senior Software Engineer","org":"WebMD","detail":"Moved to one of the largest health information platforms to work on its Android apps.","url":"https://www.linkedin.com/in/bibutikoley/"},{"date":"2020-11","title":"Promoted to Senior Software Developer","org":"OSP","detail":"Eighteen months after joining as a developer.","url":"https://www.linkedin.com/in/bibutikoley/"},{"date":"2017-08","title":"Started as an Android Developer","org":"GS Tecknoserve","detail":"The beginning of nine years of shipping mobile apps.","url":"https://www.linkedin.com/in/bibutikoley/"}]}}
